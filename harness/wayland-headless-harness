#!/usr/bin/env python3
"""Entry point: dev checkout AND the file staged into the .deb.

Auto-detects checkout-vs-installed the same way setup-env.sh already
does for wayland-proxy's own Cargo.toml -- probe for a known sibling.
HARNESS_LIB_DIR stays available as an explicit override, symmetric with
the old Bash dispatcher's own HARNESS_LIB_DIR env var.
"""
import os
import sys
from pathlib import Path

_here = Path(__file__).resolve().parent
if "HARNESS_LIB_DIR" in os.environ:
    _lib_dir = os.environ["HARNESS_LIB_DIR"]
elif (_here / "wayland_headless_harness").is_dir():
    _lib_dir = str(_here)
else:
    _lib_dir = "/usr/lib/wayland-headless-harness"
sys.path.insert(0, _lib_dir)

from wayland_headless_harness.cli import app  # noqa: E402

if __name__ == "__main__":
    app()
