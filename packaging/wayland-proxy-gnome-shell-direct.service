# Session-specific proxy unit for wl-res-gnome-shell-direct -- mirrors
# wayland-proxy-labwc.service (see that file's own comments): started by
# the session wrapper script itself, not via After=/dependency ordering
# on a compositor unit (there isn't one -- gnome-shell runs as the
# wrapper's own direct child, see
# wl-res-gnome-shell-direct-session-wrapper.sh's header for why).
#
# Target is wl-res-gnome-shell-direct-host-0, a fixed private name the
# wrapper renames gnome-shell's own socket to on every single startup and
# restart -- gnome-shell itself is actually started with
# --wayland-display=wayland-0 (this unit's own --listen= name!), not a
# private one. See docs/adr/adr-0005-route-shell-launched-clients-through-the-proxy.md
# for the full reasoning: this is deliberate, so that apps GNOME Shell
# spawns directly (Super key search, dock, Activities) -- which inherit
# WAYLAND_DISPLAY from mutter's own one-time setenv() on itself, not from
# any environment this unit or the wrapper controls -- end up pointed at
# this proxy instead of at gnome-shell directly. Only the FIRST cycle
# gets `systemctl ... start`ed by the wrapper; every gnome-shell restart
# after that sends this unit SIGUSR1 instead (`systemctl ... kill
# --signal=SIGUSR1`), which src/main.rs handles by rebinding its public
# listener in place -- deliberately not a full restart of this unit,
# which would drop every already-connected client.
#
# Conflicts= with BOTH other session proxy units: three sessions can now
# each claim the public name "wayland-0", each unconditionally
# unlink-then-bind on their own startup (src/main.rs) -- see
# wayland-proxy-gnome-shell.service's own comment for the collision this
# guards against, found live 2026-08-03 building wl-res-labwc.
#
# Testing against a plain build (no .deb installed): point ExecStart at
# the build output directly, same substitution
# packaging/wayland-proxy.service's own header documents.
#
# Wants=/After=graphical-session.target: found live 2026-08-03 --
# graphical-session.target (a standard systemd unit, not GNOME-specific)
# has RefuseManualStart=yes, so it's never reached in this
# gnome-session-bypassing session unless something else pulls it in as a
# dependency. Nothing did. Root cause behind xdg-desktop-portal-gnome.service
# (Requisite=graphical-session.target) failing outright, and very likely
# also the DING/File-roller D-Bus-activation-timeout gaps noted in
# plan-desktop-resilience.md -- both are D-Bus-activated components that
# would hit the identical gap. Since this unit is already what the
# wrapper explicitly starts once gnome-shell is up, having it pull in
# graphical-session.target as an allowed dependency (not a direct manual
# start, which is refused) fixes the gap for every
# graphical-session.target-gated component at once, not just the portal.

[Unit]
Description=Crash-resilient Wayland proxy for the wl-res-gnome-shell-direct session
Conflicts=wayland-proxy-gnome-shell.service wayland-proxy-labwc.service
Wants=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecCondition=/bin/sh -c 'test "$XDG_SESSION_DESKTOP" = "wl-res-gnome-shell-direct" || exit 2'
ExecStart=/usr/bin/wayland-proxy --display=wl-res-gnome-shell-direct-host-0 --listen=wayland-0
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
