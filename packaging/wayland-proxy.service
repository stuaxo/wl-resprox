# User systemd unit, not system -- WAYLAND_DISPLAY and XDG_RUNTIME_DIR
# are per-user-session concepts, and systemd --user already provides
# XDG_RUNTIME_DIR automatically (unlike a system unit, which would need
# PAMName= or similar to get it for a specific logged-in user). This
# matches how session components like xdg-desktop-portal are run.
#
# ExecStart assumes /usr/bin/wayland-proxy -- the eventual Phase 7 .deb
# install path, not yet real (no package exists yet). For manual testing
# before that exists, install a copy of this file with ExecStart pointed
# at the actual build output instead, e.g.:
#   sed 's#/usr/bin/wayland-proxy#/path/to/target-host/release/wayland-proxy#' \
#     packaging/wayland-proxy.service > ~/.config/systemd/user/wayland-proxy.service
#   systemctl --user daemon-reload
#   systemctl --user start wayland-proxy
#   journalctl --user -u wayland-proxy -f
#
# WAYLAND_DISPLAY: not set here -- src/main.rs already falls back to
# "wayland-1" if unset, which is wrong for most real setups. Override via
# an environment file (optional -- the leading "-" means systemd won't
# fail if it's missing) rather than editing this unit directly.

[Unit]
Description=Crash-resilient Wayland proxy
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/wayland-proxy/env
ExecStart=/usr/bin/wayland-proxy
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
