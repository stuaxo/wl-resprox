#!/usr/bin/env bash
# CLI entry point for the wayland-headless-harness package. Forwards
# subcommands to the underlying scripts, installed alongside this
# dispatcher's own scripts at $HARNESS_LIB_DIR. See `wayland-headless-harness
# help` for the full command list.
#
# Every subcommand except `test-crash` maps straight onto a host-side
# script (setup-env.sh, teardown-env.sh, start-host.sh, start-guest.sh,
# self-test.sh, test-matrix.sh, diagnose.sh, test-crash-swap.sh) --
# these all already run directly on the host. `test-crash` is the one
# exception: test-crash.sh runs INSIDE a WM container (it's the
# crash-inducer itself), so this wraps the `podman exec` call the same
# way self-test.sh's own internal invocation does.
set -euo pipefail

HARNESS_LIB_DIR="${HARNESS_LIB_DIR:-/usr/lib/wayland-headless-harness}"
# shellcheck source=/dev/null
source "$HARNESS_LIB_DIR/harness-paths.sh"

usage() {
    cat <<'EOF'
Usage: wayland-headless-harness <command> [args...]

Commands:
  setup [--wm=<name>] [--proxy-deb=<path>]
                                    Build + start a WM container.
  teardown [--wm=<name>] [--image] Stop + remove a WM container.
  start-host [port]                Headless labwc + wayvnc on the HOST.
  start-guest [--wm=<name>] [host-socket]
                                    Enter a container interactively.
  test-crash --wm=<name> [--l1] [client-app]
                                    Crash/reconnect check, inside the container.
  test-crash-swap --from=<wm> --to=<wm> [client-app]
                                    Cross-compositor swap check, on the HOST.
  self-test --wm=<name>            setup -> test-crash --l1 -> diagnose -> teardown.
  matrix [wm...]                   self-test looped over every WM (default: all four).
  diagnose [flags] [container-name]
                                    Dump compositor/Wayland state, host + guest.

Every <wm> is one of: labwc, sway, kwin, mutter (matching a
containers/<wm>/ directory shipped with this package).
EOF
}

[[ $# -ge 1 ]] || { usage >&2; exit 1; }
cmd="$1"; shift

case "$cmd" in
    setup)           exec "$HARNESS_LIB_DIR/setup-env.sh" "$@" ;;
    teardown)        exec "$HARNESS_LIB_DIR/teardown-env.sh" "$@" ;;
    start-host)      exec "$HARNESS_LIB_DIR/start-host.sh" "$@" ;;
    start-guest)     exec "$HARNESS_LIB_DIR/start-guest.sh" "$@" ;;
    test-crash-swap) exec "$HARNESS_LIB_DIR/test-crash-swap.sh" "$@" ;;
    self-test)       exec "$HARNESS_LIB_DIR/self-test.sh" "$@" ;;
    matrix)          exec "$HARNESS_LIB_DIR/test-matrix.sh" "$@" ;;
    diagnose)        exec "$HARNESS_LIB_DIR/diagnose.sh" "$@" ;;
    test-crash)
        wm=""
        rest=()
        for arg in "$@"; do
            case "$arg" in
                --wm=*) wm="${arg#--wm=}" ;;
                *) rest+=("$arg") ;;
            esac
        done
        [[ -n "$wm" ]] || { echo "ERROR: test-crash needs --wm=<name>" >&2; exit 1; }
        # $HARNESS_CONTAINER_ROOT (from harness-paths.sh), not
        # $HARNESS_LIB_DIR -- the container mounts setup-env.sh's own
        # scripts/ directory there, a completely separate concept from
        # where this dispatcher's copy happens to be installed on the host.
        exec sudo podman exec --user dev -e XDG_RUNTIME_DIR=/run/user/1000 \
            "wayland-proxy-dev-${wm}" bash -c \
            "cd $HARNESS_CONTAINER_ROOT && bash test-crash.sh $(printf '%q ' "${rest[@]}")"
        ;;
    help|-h|--help) usage ;;
    *)
        echo "ERROR: unknown command '$cmd'" >&2
        usage >&2
        exit 1
        ;;
esac
