[Desktop Entry]
Name=GNOME (crash-resilient, via wayland-proxy)
Comment=Ubuntu/GNOME on Wayland, routed through wayland-proxy so a gnome-shell crash (e.g. while locked) doesn't end the session
Exec=/usr/bin/gnome-session --session=wl-res-gnome-shell
TryExec=/usr/bin/gnome-session
Type=Application
DesktopNames=wl-res-gnome-shell;ubuntu;GNOME
X-GDM-SessionRegisters=true
X-GDM-CanRunHeadless=true
X-Ubuntu-Gettext-Domain=gnome-session
