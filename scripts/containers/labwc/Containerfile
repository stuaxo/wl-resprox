# Wayland proxy dev environment, built directly with `podman build` --
# replaces the earlier Distrobox + Ansible-provisioning-after-create
# approach (scripts/playbook.yml, now removed). That approach ran
# Distrobox's own container-init script (`distrobox-init`, bind-mounted in
# as `/usr/bin/entrypoint`), which unconditionally attempts an interactive
# password reset for the container user on every session -- harmless in
# practice (it fails fast, non-interactively, rather than hanging) but
# noisy, and was the reason `sudo` never had a working password for the
# container user in the first place (see the 2026-07-29/2026-07-30
# entries in docs/debugging-notes.md for the full history). Building our
# own image means we control user/sudoers setup entirely at build time
# and never run that script at all.
#
# Devcontainer-style, deliberately: the container's own user, home
# directory, and dotfiles are self-contained in the image, independent of
# whoever's host account builds it. Only the project directory itself is
# bind-mounted in (at /workspace -- see scripts/setup-env.sh), not $HOME --
# see that script's own comment for why (a whole-$HOME mount silently
# shadows anything this image bakes into a user's home directory, and
# risks the container writing into the host's real home directory).
#
# One Containerfile per compositor under scripts/containers/<wm>/ --
# see plan-test-harness.md Phase 9. Deliberately separate files, not one
# parameterized template: different compositors need genuinely different
# apt packages (kwin/plasma needs far more than labwc/sway), and with
# only two WMs done so far it's too early to know what's actually shared
# vs. coincidentally similar.
#
# Build: podman build -t wayland-proxy-dev-labwc -f scripts/containers/labwc/Containerfile scripts/containers/labwc/
# Run:   see scripts/setup-env.sh --wm=labwc, which also handles the
#        render/video GID matching and the project mount this image
#        alone doesn't set up (those are host-specific, not build-time
#        facts).

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# psmisc (fuser) and iproute2 (ss): not needed by the proxy or labwc
# themselves, but scripts/diagnose.sh depends on both for live/stale
# socket detection and XWayland-slot ownership -- confirmed missing live
# (diagnose.sh silently reported everything as "stale" inside the
# container until these were added).
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    sudo \
    rustc \
    cargo \
    libgtk-4-dev \
    gtk-4-examples \
    labwc \
    libwayland-dev \
    wayland-utils \
    dbus \
    wev \
    psmisc \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# GID/UID values are baked in as build args, not hardcoded -- host-specific
# facts, passed by scripts/setup-env.sh at build time (its own `id -u`/
# `getent group video render` calls). Matching them is what lets the
# container's `dev` user actually use /dev/dri and the bind-mounted
# XDG_RUNTIME_DIR without a permissions mismatch -- only the numeric
# UID/GID need to match the host, not the username, which is why the
# username itself is a fixed, generic `dev` rather than mirroring
# whoever's host account happens to be running this.
ARG USER_UID=1000
ARG USER_GID=1000
ARG VIDEO_GID=44
ARG RENDER_GID=991

# Ubuntu's own base image ships a default `ubuntu` user/group at
# UID/GID 1000 (the common case for a first host user account) -- remove
# it first so it doesn't collide with the group/useradd calls below.
RUN userdel -r ubuntu 2>/dev/null; groupdel ubuntu 2>/dev/null; true

RUN groupadd -g "${USER_GID}" dev \
    && (groupmod -g "${VIDEO_GID}" video 2>/dev/null || groupadd -g "${VIDEO_GID}" video) \
    && groupadd -g "${RENDER_GID}" render \
    && useradd -u "${USER_UID}" -g "${USER_GID}" -G video,render,sudo -m -s /bin/bash dev

# A loud PS1 prefix, so a container shell is never mistaken for a host
# one -- `hostname` alone doesn't help here (--network host shares the
# UTS namespace too, confirmed live: identical `hostname` output both
# sides). Appended to dev's own ~/.bashrc -- safe now that $HOME isn't
# bind-mounted from the host (see the file header). Tried /etc/bash.bashrc
# first: it IS sourced (confirmed with a marker var), but Ubuntu's stock
# ~/.bashrc sets PS1 itself further down its own color_prompt logic and
# runs after /etc/bash.bashrc, so it clobbered this every time. Appending
# here instead means it runs last and wins. $CONTAINER_ID is set below,
# already used by diagnose.sh for the same "am I in the container" check.
RUN echo 'export PS1="\[\e[1;41;37m\][${CONTAINER_ID}]\[\e[0m\] ${PS1}"' >> /home/dev/.bashrc

# Passwordless sudo baked in at build time -- no interactive password flow
# exists anywhere in this image, so there's nothing that can be caught
# mid-setup the way distrobox-init's was.
RUN echo "dev ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/zz-dev-nopasswd \
    && chmod 0440 /etc/sudoers.d/zz-dev-nopasswd \
    && visudo -cf /etc/sudoers.d/zz-dev-nopasswd

# /workspace: fixed, generic mount point for the project (scripts/setup-env.sh
# bind-mounts it there) -- created and owned by `dev` here, as root, since
# `dev` can't create anything directly under root:root 0755 /.
RUN mkdir -p /workspace && chown dev:dev /workspace

USER dev
WORKDIR /workspace

# scripts/diagnose.sh detects "am I running inside the container" via this
# -- previously set automatically by Distrobox, now set explicitly since
# nothing else provides it. Per-WM value (not just "wayland-proxy-dev")
# so the PS1 prefix tells you which compositor's container you're in.
ENV CONTAINER_ID=wayland-proxy-dev-labwc

# entrypoint.sh/test-crash.sh dispatch on this to know which compositor
# binary/config/launch flags to use -- see their own COMPOSITOR case
# statements.
ENV COMPOSITOR=labwc
