# Wayland proxy dev environment, built directly with `podman build` --
# see scripts/containers/labwc/Containerfile's header comment for the
# full Distrobox/devcontainer-style rationale, identical here. This file
# differs from that one only in which compositor package it installs and
# the two ENV values at the bottom -- see plan-test-harness.md Phase 9
# for why these are separate files rather than one parameterized
# template.
#
# gnome-shell (there's no standalone `mutter` binary on this Ubuntu --
# mutter ships only as a library, libmutter, that gnome-shell links
# against) pulls in the full GNOME desktop stack as hard dependencies:
# gnome-control-center, gnome-settings-daemon, NetworkManager/polkit/
# pipewire GI bindings, evolution-data-server, ubuntu-wallpapers -- all
# `Depends:`, not `Recommends:`, confirmed via `apt-cache depends
# gnome-shell` on the host. This is the heaviest of the three WM images
# so far, matching plan-test-harness.md's own risk note for this entry.
#
# Build: podman build -t wayland-proxy-dev-mutter -f scripts/containers/mutter/Containerfile scripts/containers/mutter/
#        (needs wayland-proxy-dev-base already built -- see
#        scripts/containers/base/Containerfile)
# Run:   see harness/'s `env setup --wm=mutter`, which also handles the
#        render/video GID matching and the project mount this image
#        alone doesn't set up (those are host-specific, not build-time
#        facts).

FROM wayland-proxy-dev-base:latest

# gnome-shell's own dependency stack (see the header comment above)
# claims several GIDs of its own at this step -- before the group/user
# creation block below runs -- which is exactly why that block needs
# the generalized GID-collision handling it has (kwin's Containerfile
# needs the identical pattern for the same underlying reason -- see its
# own comment).
RUN apt-get update && apt-get install -y gnome-shell && rm -rf /var/lib/apt/lists/*

# GID/UID values are baked in as build args, not hardcoded -- host-specific
# facts, passed by scripts/setup-env.sh at build time (its own `id -u`/
# `getent group video render` calls). Matching them is what lets the
# container's `dev` user actually use /dev/dri and the bind-mounted
# XDG_RUNTIME_DIR without a permissions mismatch -- only the numeric
# UID/GID need to match the host, not the username, which is why the
# username itself is a fixed, generic `dev` rather than mirroring
# whoever's host account happens to be running this.
ARG USER_UID=1000
ARG USER_GID=1000
ARG VIDEO_GID=44
ARG RENDER_GID=991

# The base image already removed Ubuntu's default `ubuntu` user/group
# (see scripts/containers/base/Containerfile).
#
# GNOME's stack pulls in far more system accounts/groups than
# labwc/sway/kwin's images do (gdm, rygel, and others each claim their
# own GID at package-install time) -- confirmed live on this host that
# one of them (`clock`, a systemd/timedated group, nothing to do with
# video/render) happened to already be sitting on this host's actual
# RENDER_GID value, so the groupmod-with-fallback pattern kwin's
# Containerfile introduced (retry as groupadd if the target group
# doesn't exist yet) wasn't enough here: groupmod failed for a
# *different* reason (target GID taken by an unrelated group), fell
# through to groupadd, which then failed too (render already exists,
# just at the wrong GID). Generalized fix: whatever already holds the
# target GID gets moved out of the way first (to a high, arbitrary,
# unused GID -- its own numeric identity doesn't matter, nothing in this
# image depends on it), *then* video/render get groupmod'd or created at
# the exact host-matching GID either way.
RUN groupadd -g "${USER_GID}" dev \
    && for pair in "video:${VIDEO_GID}" "render:${RENDER_GID}"; do \
         name="${pair%%:*}"; gid="${pair##*:}"; \
         conflict="$(getent group "$gid" | cut -d: -f1)"; \
         if [ -n "$conflict" ] && [ "$conflict" != "$name" ]; then \
           groupmod -g "$((gid + 50000))" "$conflict"; \
         fi; \
         if getent group "$name" >/dev/null; then \
           groupmod -g "$gid" "$name"; \
         else \
           groupadd -g "$gid" "$name"; \
         fi; \
       done \
    && useradd -u "${USER_UID}" -g "${USER_GID}" -G video,render,sudo -m -s /bin/bash dev

# A loud PS1 prefix, so a container shell is never mistaken for a host
# one -- see scripts/containers/labwc/Containerfile's own comment for
# the full story (tried /etc/bash.bashrc first, Ubuntu's stock ~/.bashrc
# clobbers it, appending here instead runs last and wins).
RUN echo 'export PS1="\[\e[1;41;37m\][${CONTAINER_ID}]\[\e[0m\] ${PS1}"' >> /home/dev/.bashrc

# Passwordless sudo baked in at build time -- no interactive password flow
# exists anywhere in this image, so there's nothing that can be caught
# mid-setup the way distrobox-init's was.
RUN echo "dev ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/zz-dev-nopasswd \
    && chmod 0440 /etc/sudoers.d/zz-dev-nopasswd \
    && visudo -cf /etc/sudoers.d/zz-dev-nopasswd

# /workspace: fixed, generic mount point for the project (scripts/setup-env.sh
# bind-mounts it there) -- created and owned by `dev` here, as root, since
# `dev` can't create anything directly under root:root 0755 /.
RUN mkdir -p /workspace && chown dev:dev /workspace

USER dev
WORKDIR /workspace

# scripts/diagnose.sh detects "am I running inside the container" via this
# -- per-WM value so the PS1 prefix tells you which compositor's
# container you're in.
ENV CONTAINER_ID=wayland-proxy-dev-mutter

# entrypoint.sh/test-crash.sh dispatch on this to know which compositor
# binary/config/launch flags to use -- see their own COMPOSITOR case
# statements.
ENV COMPOSITOR=mutter
