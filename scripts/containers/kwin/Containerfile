# Wayland proxy dev environment, built directly with `podman build` --
# see scripts/containers/labwc/Containerfile's header comment for the
# full Distrobox/devcontainer-style rationale, identical here. This file
# differs from that one only in which compositor package it installs and
# the two ENV values at the bottom -- see plan-test-harness.md Phase 9
# for why these are separate files rather than one parameterized
# template.
#
# kwin-wayland pulls in the full KDE Frameworks/Qt6 stack plus xwayland
# (a hard dependency here, unlike labwc/sway where it's absent by
# choice -- see those Containerfiles). No separate
# kwin-wayland-backend-virtual package on this base: older Debian/Ubuntu
# split the virtual backend out, but Plasma 6's kwin-wayland ships it
# in the main binary -- confirmed via `apt-cache depends kwin-wayland`
# on the host, no such package exists to install separately.
#
# Build: podman build -t wayland-proxy-dev-kwin -f scripts/containers/kwin/Containerfile scripts/containers/kwin/
#        (needs wayland-proxy-dev-base already built -- see
#        scripts/containers/base/Containerfile)
# Run:   see harness/'s `env setup --wm=kwin`, which also handles the
#        render/video GID matching and the project mount this image
#        alone doesn't set up (those are host-specific, not build-time
#        facts).

FROM wayland-proxy-dev-base:latest

# kwin-wayland's own package dependencies (systemd/udev rules pulled in
# transitively) pre-create a `render` group at THIS step -- before the
# group/user creation block below ever runs -- which is exactly why that
# block needs the groupmod-or-groupadd fallback it has, unlike labwc/
# sway's plain groupadd.
RUN apt-get update && apt-get install -y kwin-wayland && rm -rf /var/lib/apt/lists/*

# GID/UID values are baked in as build args, not hardcoded -- host-specific
# facts, passed by scripts/setup-env.sh at build time (its own `id -u`/
# `getent group video render` calls). Matching them is what lets the
# container's `dev` user actually use /dev/dri and the bind-mounted
# XDG_RUNTIME_DIR without a permissions mismatch -- only the numeric
# UID/GID need to match the host, not the username, which is why the
# username itself is a fixed, generic `dev` rather than mirroring
# whoever's host account happens to be running this.
ARG USER_UID=1000
ARG USER_GID=1000
ARG VIDEO_GID=44
ARG RENDER_GID=991

# The base image already removed Ubuntu's default `ubuntu` user/group
# (see scripts/containers/base/Containerfile).
#
# Unlike labwc/sway's images, one of kwin-wayland's own dependencies
# (systemd/udev rules pulled in transitively) already creates a `render`
# group at build time here, so `groupadd` alone (which worked for
# labwc/sway) fails with "group 'render' already exists" -- confirmed
# live. Originally handled with a simpler groupmod-or-groupadd fallback
# (rename the existing group's GID if present, create it fresh if not),
# but factoring the common apt packages into their own base-image build
# (see scripts/containers/base/Containerfile) surfaced the same class of
# GID-collision mutter's image already has to handle: with the base
# packages now installed in a separate transaction before kwin-wayland's
# own, apt/dpkg's dynamic system-GID allocation lands differently, and
# GID 991 can end up already claimed by some *other* system group before
# kwin-wayland's postinst ever creates `render` -- confirmed live
# (`groupadd: group 'render' already exists` after a silently-failed
# `groupmod`, because `render` existed at the wrong GID, not because it
# was missing). The simple fallback only handled "group doesn't exist
# yet," not "the target GID is occupied by something else" -- same
# generalized fix as mutter/Containerfile: move whatever's sitting on
# the target GID out of the way first, then groupmod-or-groupadd either
# way.
RUN groupadd -g "${USER_GID}" dev \
    && for pair in "video:${VIDEO_GID}" "render:${RENDER_GID}"; do \
         name="${pair%%:*}"; gid="${pair##*:}"; \
         conflict="$(getent group "$gid" | cut -d: -f1)"; \
         if [ -n "$conflict" ] && [ "$conflict" != "$name" ]; then \
           groupmod -g "$((gid + 50000))" "$conflict"; \
         fi; \
         if getent group "$name" >/dev/null; then \
           groupmod -g "$gid" "$name"; \
         else \
           groupadd -g "$gid" "$name"; \
         fi; \
       done \
    && useradd -u "${USER_UID}" -g "${USER_GID}" -G video,render,sudo -m -s /bin/bash dev

# A loud PS1 prefix, so a container shell is never mistaken for a host
# one -- see scripts/containers/labwc/Containerfile's own comment for
# the full story (tried /etc/bash.bashrc first, Ubuntu's stock ~/.bashrc
# clobbers it, appending here instead runs last and wins).
RUN echo 'export PS1="\[\e[1;41;37m\][${CONTAINER_ID}]\[\e[0m\] ${PS1}"' >> /home/dev/.bashrc

# Passwordless sudo baked in at build time -- no interactive password flow
# exists anywhere in this image, so there's nothing that can be caught
# mid-setup the way distrobox-init's was.
RUN echo "dev ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/zz-dev-nopasswd \
    && chmod 0440 /etc/sudoers.d/zz-dev-nopasswd \
    && visudo -cf /etc/sudoers.d/zz-dev-nopasswd

# /workspace: fixed, generic mount point for the project (scripts/setup-env.sh
# bind-mounts it there) -- created and owned by `dev` here, as root, since
# `dev` can't create anything directly under root:root 0755 /.
RUN mkdir -p /workspace && chown dev:dev /workspace

# kwin_wayland ships with the file capability cap_sys_nice=ep (for
# realtime thread priority on a real desktop). Confirmed live: execve()
# of a capability-carrying binary fails outright with EPERM in this
# rootless-podman user namespace -- not a /dev/dri permissions issue
# like the video/render GID one, a completely different failure mode
# (the shell itself can't even exec the file). Stripping the capability
# is the fix, not adding it back via --cap-add on the podman run side --
# this is a single WM's binary quirk, not something setup-env.sh (shared
# across all --wm= targets) should carry. Losing cap_sys_nice just makes
# kwin log a non-fatal "Failed to gain real time thread priority"
# warning and continue -- a fine trade for a headless test compositor.
RUN setcap -r /usr/bin/kwin_wayland

USER dev
WORKDIR /workspace

# scripts/diagnose.sh detects "am I running inside the container" via this
# -- per-WM value so the PS1 prefix tells you which compositor's
# container you're in.
ENV CONTAINER_ID=wayland-proxy-dev-kwin

# entrypoint.sh/test-crash.sh dispatch on this to know which compositor
# binary/config/launch flags to use -- see their own COMPOSITOR case
# statements.
ENV COMPOSITOR=kwin
